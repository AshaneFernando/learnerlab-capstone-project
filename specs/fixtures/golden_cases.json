{
  "_meta": {
    "synthetic": true,
    "description": "SYNTHETIC development and test data. Golden expected results for LearnLab's deterministic domain rules. Agents generate parametrised tests from these cases; a case's expected value is the spec's answer, never the code's.",
    "source_specs": [
      "specs/app_spec.md",
      "specs/course-authoring_spec.md",
      "specs/catalog_spec.md",
      "specs/enrollment_spec.md",
      "specs/progress-tracker_spec.md",
      "specs/quiz-engine_spec.md",
      "specs/instructor-workbench_spec.md"
    ],
    "version": 1,
    "conventions": {
      "actors": "LEARNER, LEARNER_ENROLLED, LEARNER_NOT_ENROLLED, LEARNER_OTHER, INSTRUCTOR_OWNER, INSTRUCTOR_OTHER, ADMIN, VISITOR (no token)",
      "expected_error": "{\"error_code\": <code from app_spec §8.1>, \"http_status\": <int>}",
      "role_boundaries_expected": "map of actor -> HTTP status for the request in input"
    }
  },

